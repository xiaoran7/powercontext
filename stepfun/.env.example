# StepFun × SeekDB 运行配置示例
# 复制为 .env 或在启动前 export；所有项都有默认值，开箱即可本地运行。

# ---- SeekDB 连接 ----
# 留空 / 不设置 = 自动使用本机 seekdb（127.0.0.1:2881），未运行时自动拉起。
# 设置后则连接指定实例（远程模式，不会尝试启动本地进程）。
SEEKDB_HOST=
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASS=
SEEKDB_DB=powercontext

# ---- 本地 seekdb 实例 ----
# seekdb 可执行文件路径；不设置时从 PATH 中查找 seekdb。
# 示例：SEEKDB_BIN=/opt/seekdb/bin/seekdb
SEEKDB_BIN=
# 本地实例的数据 / 日志目录（默认 stepfun/seekdb_data）
SEEKDB_BASE_DIR=
SEEKDB_DATA_DIR=
SEEKDB_LOG_DIR=
# 置为 0 可禁止服务自动拉起本地 seekdb（仅连接已有实例）
SEEKDB_AUTO_START=1

# ---- 应用 ----
# FastAPI 监听地址与端口（默认 127.0.0.1:8088）
APP_HOST=127.0.0.1
APP_PORT=8088
